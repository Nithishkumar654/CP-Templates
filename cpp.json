  "Z Function": {
    "prefix": "zfunction",
    "body": [
      "vector<int> Z_function(string& s) {",
      " ",
      "  int n = s.length();",
      "  vector<int> Z(n, 0);",
      "  // calculates the longest length of substring starting at i",
      "  // that is also prefix of string",
      " ",
      "  int l = 0, r = 0;",
      "  for (int i = 1; i < n; i++) {",
      "    if (i < r) {",
      "      Z[i] = min(r - i, Z[i - l]);",
      "    }",
      "    while (i + Z[i] < n && s[Z[i]] == s[i + Z[i]]) {",
      "      Z[i]++;",
      "    }",
      "    if (i + Z[i] > r) {",
      "      l = i;",
      "      r = i + Z[i];",
      "    }",
      "  }",
      "  return Z;",
      "}"
    ],
    "description": "Z Function"
  },
