  "HLD Generic": {
    "prefix": "hld",
    "body": [
      "template<class T, class F>",
      "class HLD {",
      "  int n, timer;",
      "  T ID;",
      "  F combine;",
      "",
      "  vector<vector<int>> g;",
      "  vector<int> parent, depth, heavy, sz;",
      "  vector<int> head, pos;",
      "  vector<T> value, seg;",
      "",
      "  void updateSeg(int p, const T& val) {",
      "    p += n;",
      "    seg[p] = val;",
      "    for (p >>= 1; p; p >>= 1)",
      "      seg[p] = combine(seg[p << 1], seg[p << 1 | 1]);",
      "  }",
      "",
      "  T querySeg(int l, int r) const {",
      "    T left = ID, right = ID;",
      "    for (l += n, r += n; l < r; l >>= 1, r >>= 1) {",
      "      if (l & 1)",
      "        left = combine(left, seg[l++]);",
      "      if (r & 1)",
      "        right = combine(seg[--r], right);",
      "    }",
      "    return combine(left, right);",
      "  }",
      "",
      "  void dfs(int u, int p) {",
      "    parent[u] = p;",
      "    sz[u] = 1;",
      "    heavy[u] = -1;",
      "    int best = 0;",
      "",
      "    for (int v : g[u]) {",
      "      if (v == p) continue;",
      "      depth[v] = depth[u] + 1;",
      "      dfs(v, u);",
      "      sz[u] += sz[v];",
      "",
      "      if (sz[v] > best) {",
      "        best = sz[v];",
      "        heavy[u] = v;",
      "      }",
      "    }",
      "  }",
      "",
      "  void decompose(int u, int h) {",
      "    head[u] = h;",
      "    pos[u] = timer++;",
      "",
      "    if (heavy[u] != -1)",
      "      decompose(heavy[u], h);",
      "",
      "    for (int v : g[u]) {",
      "      if (v == parent[u] || v == heavy[u]) continue;",
      "      decompose(v, v);",
      "    }",
      "  }",
      "",
      "public:",
      "  HLD(int n, T identity, F combine)",
      "      : n(n), timer(0), ID(identity), combine(std::move(combine)),",
      "        g(n), parent(n, -1), depth(n), heavy(n, -1), sz(n),",
      "        head(n), pos(n), value(n, ID), seg(2 * n, ID) {}",
      "",
      "  void addEdge(int u, int v) {",
      "    g[u].push_back(v);",
      "    g[v].push_back(u);",
      "  }",
      "",
      "  void build(int root = 0, const vector<T>& a = {}) {",
      "    if (!a.empty()) value = a;",
      "",
      "    dfs(root, -1);",
      "    decompose(root, root);",
      "",
      "    for (int u = 0; u < n; ++u)",
      "      seg[n + pos[u]] = value[u];",
      "",
      "    for (int i = n - 1; i >= 1; --i)",
      "      seg[i] = combine(seg[i << 1], seg[i << 1 | 1]);",
      "  }",
      "",
      "  void setValue(int u, const T& x) {",
      "    value[u] = x;",
      "    updateSeg(pos[u], x);",
      "  }",
      "",
      "  T queryPath(int u, int v) const {",
      "    T left = ID, right = ID;",
      "",
      "    while (head[u] != head[v]) {",
      "      if (depth[head[u]] > depth[head[v]]) {",
      "        left = combine(",
      "            querySeg(pos[head[u]], pos[u] + 1),",
      "            left",
      "        );",
      "        u = parent[head[u]];",
      "      }",
      "      else {",
      "        right = combine(",
      "            querySeg(pos[head[v]], pos[v] + 1),",
      "            right",
      "        );",
      "        v = parent[head[v]];",
      "      }",
      "    }",
      "",
      "    if (depth[u] > depth[v]) {",
      "      left = combine(",
      "          querySeg(pos[v], pos[u] + 1),",
      "          left",
      "      );",
      "    }",
      "    else {",
      "      left = combine(",
      "          left,",
      "          querySeg(pos[u], pos[v] + 1)",
      "      );",
      "    }",
      "",
      "    return combine(left, right);",
      "  }",
      "",
      "  T querySubtree(int u) const {",
      "    return querySeg(pos[u], pos[u] + sz[u]);",
      "  }",
      "",
      "  int getParent(int u) const { return parent[u]; }",
      "  int getDepth(int u) const { return depth[u]; }",
      "  int getPosition(int u) const { return pos[u]; }",
      "  int getHead(int u) const { return head[u]; }",
      "};"
    ],
    "description": "Generic Heavy-Light Decomposition with point updates and path/subtree queries"
  },
  "Combinatorics": {
    "prefix": "comb",
    "body": [
      "struct Comb {",
      "  int n;",
      "  vector<Mint> fact, invFact;",
      "",
      "  Comb(int n) : n(n), fact(n + 1), invFact(n + 1) {",
      "    fact[0] = 1;",
      "    for (int i = 1; i <= n; ++i)",
      "      fact[i] = fact[i - 1] * i;",
      "",
      "    invFact[n] = fact[n].inv();",
      "    for (int i = n; i >= 1; --i)",
      "      invFact[i - 1] = invFact[i] * i;",
      "  }",
      "",
      "  Mint C(int n, int r) const {",
      "    if (r < 0 || r > n) return 0;",
      "    return fact[n] * invFact[r] * invFact[n - r];",
      "  }",
      "",
      "  Mint P(int n, int r) const {",
      "    if (r < 0 || r > n) return 0;",
      "    return fact[n] * invFact[n - r];",
      "  }",
      "",
      "  Mint H(int n, int r) const {",
      "    if (n == 0) return r == 0 ? 1 : 0;",
      "    return C(n + r - 1, r);",
      "  }",
      "",
      "  Mint catalan(int n) const {",
      "    return C(2 * n, n) / (n + 1);",
      "  }",
      "};",
      "Comb comb(N);"
    ],
    "description": "Factorials, inverse factorials, combinations, permutations and repetition"
  },
  "Mo's Algorithm": {
    "prefix": "mo",
    "body": [
      "struct Query {",
      "    int l, r, idx;",
      "    static int BLOCK;",
      "",
      "    bool operator<(const Query& other) const {",
      "        int b1 = l / BLOCK;",
      "        int b2 = other.l / BLOCK;",
      "",
      "        if (b1 != b2)",
      "            return b1 < b2;",
      "",
      "        return (b1 & 1) ? r > other.r : r < other.r;",
      "    }",
      "};",
      "",
      "int Query::BLOCK;",
      "",
      "vector<int> mo_solve(const vector<int>& a, vector<Query> queries) {",
      "    int n = a.size();",
      "    Query::BLOCK = max(1, (int)sqrt(n));",
      "",
      "    sort(queries.begin(), queries.end());",
      "",
      "    vector<int> ans(queries.size());",
      "",
      "    // Example state: number of distinct values in [L, R].",
      "    unordered_map<int, int> freq;",
      "    int distinct = 0;",
      "",
      "    auto add = [&](int pos) {",
      "        if (++freq[a[pos]] == 1)",
      "            ++distinct;",
      "    };",
      "",
      "    auto remove = [&](int pos) {",
      "        if (--freq[a[pos]] == 0)",
      "            --distinct;",
      "    };",
      "",
      "    int L = 0, R = -1;",
      "",
      "    for (const auto& q : queries) {",
      "        while (L > q.l) add(--L);",
      "        while (R < q.r) add(++R);",
      "        while (L < q.l) remove(L++);",
      "        while (R > q.r) remove(R--);",
      "",
      "        ans[q.idx] = distinct;",
      "    }",
      "",
      "    return ans;",
      "}",
      "$0"
    ],
    "description": "Mo's algorithm with alternating R-order comparator inside Query"
  },
  "Li Chao Tree": {
    "prefix": "lichao",
    "body": [
      "struct LiChao {",
      "    static constexpr long long INF = (1LL << 62);",
      "",
      "    struct Line {",
      "        long long m, b;",
      "",
      "        Line(long long m = 0, long long b = INF)",
      "            : m(m), b(b) {}",
      "",
      "        long long eval(long long x) const {",
      "            return m * x + b;",
      "        }",
      "    };",
      "",
      "    long long X_MIN, X_MAX;",
      "    int n;",
      "    vector<Line> tree;",
      "",
      "    LiChao(long long X_MIN = -1'000'000'000LL, long long X_MAX =  1'000'000'000LL)",
      "        : X_MIN(X_MIN), X_MAX(X_MAX) {",
      "        n = 1;",
      "        while (n < X_MAX - X_MIN + 1)",
      "            n <<= 1;",
      "",
      "        tree.assign(2 * n, Line());",
      "    }",
      "",
      "    void addLine(Line nw, int node, long long l, long long r) {",
      "        long long mid = l + (r - l) / 2;",
      "",
      "        bool lef = nw.eval(l) < tree[node].eval(l);",
      "        bool midBetter = nw.eval(mid) < tree[node].eval(mid);",
      "",
      "        if (midBetter)",
      "            swap(tree[node], nw);",
      "",
      "        if (l == r)",
      "            return;",
      "",
      "        if (lef != midBetter)",
      "            addLine(nw, node * 2, l, mid);",
      "        else",
      "            addLine(nw, node * 2 + 1, mid + 1, r);",
      "    }",
      "",
      "    void addLine(long long m, long long b) {",
      "        addLine({m, b}, 1, X_MIN, X_MIN + n - 1);",
      "    }",
      "",
      "    long long query(long long x, int node, long long l, long long r) const {",
      "        long long ans = tree[node].eval(x);",
      "",
      "        if (l == r)",
      "            return ans;",
      "",
      "        long long mid = l + (r - l) / 2;",
      "",
      "        if (x <= mid)",
      "            ans = min(ans, query(x, node * 2, l, mid));",
      "        else",
      "            ans = min(ans, query(x, node * 2 + 1, mid + 1, r));",
      "",
      "        return ans;",
      "    }",
      "",
      "    long long query(long long x) const {",
      "        return query(x, 1, X_MIN, X_MIN + n - 1);",
      "    }",
      "};",
      "$0"
    ],
    "description": "Li Chao Tree for minimum line queries with arbitrary insertion/query order"
  },
  "Aho-Corasick": {
    "prefix": "ahocorasick",
    "body": [
      "// many patterns + one text",
      "struct AhoCorasick {",
      "    static constexpr int ALPHA = 26;",
      "",
      "    struct Node {",
      "        array<int, ALPHA> nxt;",
      "        int link = 0;",
      "        vector<int> out;",
      "",
      "        Node() {",
      "            nxt.fill(-1);",
      "        }",
      "    };",
      "",
      "    vector<Node> tr;",
      "    vector<int> patternCount;",
      "",
      "    AhoCorasick() {",
      "        tr.emplace_back();",
      "    }",
      "",
      "    int insert(const string& s) {",
      "        int u = 0;",
      "",
      "        for (char c : s) {",
      "            int x = c - 'a';",
      "",
      "            if (tr[u].nxt[x] == -1) {",
      "                tr[u].nxt[x] = tr.size();",
      "                tr.emplace_back();",
      "            }",
      "",
      "            u = tr[u].nxt[x];",
      "        }",
      "",
      "        int id = patternCount.size();",
      "        patternCount.push_back(0);",
      "        tr[u].out.push_back(id);",
      "",
      "        return id;",
      "    }",
      "",
      "    void build() {",
      "        queue<int> q;",
      "",
      "        for (int c = 0; c < ALPHA; ++c) {",
      "            int v = tr[0].nxt[c];",
      "",
      "            if (v == -1) {",
      "                tr[0].nxt[c] = 0;",
      "            } else {",
      "                tr[v].link = 0;",
      "                q.push(v);",
      "            }",
      "        }",
      "",
      "        while (!q.empty()) {",
      "            int u = q.front();",
      "            q.pop();",
      "",
      "            for (int id : tr[tr[u].link].out)",
      "                tr[u].out.push_back(id);",
      "",
      "            for (int c = 0; c < ALPHA; ++c) {",
      "                int v = tr[u].nxt[c];",
      "",
      "                if (v == -1) {",
      "                    tr[u].nxt[c] = tr[tr[u].link].nxt[c];",
      "                } else {",
      "                    tr[v].link = tr[tr[u].link].nxt[c];",
      "                    q.push(v);",
      "                }",
      "            }",
      "        }",
      "    }",
      "",
      "    vector<int> search(const string& text) {",
      "        vector<int> cnt(patternCount.size());",
      "        int u = 0;",
      "",
      "        for (char c : text) {",
      "            u = tr[u].nxt[c - 'a'];",
      "",
      "            for (int id : tr[u].out)",
      "                ++cnt[id];",
      "        }",
      "",
      "        return cnt;",
      "    }",
      "};",
      "$0"
    ],
    "description": "Aho-Corasick multi-pattern string matching"
  },
  "Rollback DSU": {
    "prefix": "rdsu",
    "body": [
      "struct RollbackDSU {",
      "    vector<int> parent, sz;",
      "    int components;",
      "",
      "    struct Change {",
      "        int a, b, sz_a;",
      "    };",
      "",
      "    vector<Change> history;",
      "",
      "    RollbackDSU(int n) : parent(n), sz(n, 1), components(n) {",
      "        iota(parent.begin(), parent.end(), 0);",
      "    }",
      "",
      "    int find(int x) {",
      "        while (x != parent[x])",
      "            x = parent[x];",
      "        return x;",
      "    }",
      "",
      "    bool unite(int a, int b) {",
      "        a = find(a);",
      "        b = find(b);",
      "",
      "        if (a == b) {",
      "            history.push_back({-1, -1, -1});",
      "            return false;",
      "        }",
      "",
      "        if (sz[a] < sz[b])",
      "            swap(a, b);",
      "",
      "        history.push_back({a, b, sz[a]});",
      "",
      "        parent[b] = a;",
      "        sz[a] += sz[b];",
      "        --components;",
      "",
      "        return true;",
      "    }",
      "",
      "    int snapshot() const {",
      "        return history.size();",
      "    }",
      "",
      "    void rollback(int snap) {",
      "        while ((int)history.size() > snap) {",
      "            auto [a, b, old_sz_a] = history.back();",
      "            history.pop_back();",
      "",
      "            if (a == -1)",
      "                continue;",
      "",
      "            parent[b] = b;",
      "            sz[a] = old_sz_a;",
      "            ++components;",
      "        }",
      "    }",
      "",
      "    bool same(int a, int b) {",
      "        return find(a) == find(b);",
      "    }",
      "",
      "    int size(int x) {",
      "        return sz[find(x)];",
      "    }",
      "};",
      "$0"
    ],
    "description": "DSU with rollback / undo support"
  },
  "SPF Sieve": {
    "prefix": "sieve",
    "body": [
      "vector<int> build_spf(int n) {",
      "    vector<int> spf(n + 1);",
      "",
      "    for (int i = 0; i <= n; ++i)",
      "        spf[i] = i;",
      "",
      "    if (n >= 1) spf[1] = 1;",
      "",
      "    for (int i = 2; 1LL * i * i <= n; ++i) {",
      "        if (spf[i] != i)",
      "            continue;",
      "",
      "        for (int j = i * i; j <= n; j += i) {",
      "            if (spf[j] == j)",
      "                spf[j] = i;",
      "        }",
      "    }",
      "",
      "    return spf;",
      "}",
      "$0"
    ],
    "description": "Smallest Prime Factor sieve"
  },
  "Fenwick Tree": {
    "prefix": "fenwick",
    "body": [
      "class Fenwick {",
      "  int n;",
      "  vector<long long> bit;",
      "",
      "public:",
      "  Fenwick(int n) : n(n), bit(n + 1, 0) {}",
      "",
      "  void add(int i, long long x) {",
      "    for (; i <= n; i += i & -i)",
      "      bit[i] += x;",
      "  }",
      "",
      "  long long sum(int i) const {",
      "    long long res = 0;",
      "    for (; i > 0; i -= i & -i)",
      "      res += bit[i];",
      "    return res;",
      "  }",
      "",
      "  long long sum(int l, int r) const {",
      "    if (l > r) return 0;",
      "    return sum(r) - sum(l - 1);",
      "  }",
      "",
      "  void setVal(int i, long long oldValue, long long newValue) {",
      "    add(i, newValue - oldValue);",
      "  }",
      "",
      "  int kth(long long k) const {",
      "    int pos = 0;",
      "    long long cur = 0;",
      "    int pw = 1;",
      "    while ((pw << 1) <= n) pw <<= 1;",
      "",
      "    for (int jump = pw; jump; jump >>= 1) {",
      "      int nxt = pos + jump;",
      "      if (nxt <= n && cur + bit[nxt] < k) {",
      "        pos = nxt;",
      "        cur += bit[nxt];",
      "      }",
      "    }",
      "    return pos + 1;",
      "  }",
      "};"
    ],
    "description": "Fenwick Tree / Binary Indexed Tree"
  },
  "Dijkstra": {
    "prefix": "dijkstra",
    "body": [
      "vector<long long> dijkstra(",
      "    int n,",
      "    const vector<vector<pair<int, int>>>& g,",
      "    int src",
      ") {",
      "  const long long INF = 4e18;",
      "  vector<long long> dist(n, INF);",
      "",
      "  priority_queue<",
      "      pair<long long, int>,",
      "      vector<pair<long long, int>>,",
      "      greater<pair<long long, int>>",
      "  > pq;",
      "",
      "  dist[src] = 0;",
      "  pq.push({0, src});",
      "",
      "  while (!pq.empty()) {",
      "    auto [d, u] = pq.top();",
      "    pq.pop();",
      "",
      "    if (d != dist[u]) continue;",
      "",
      "    for (auto [v, w] : g[u]) {",
      "      if (dist[v] > d + w) {",
      "        dist[v] = d + w;",
      "        pq.push({dist[v], v});",
      "      }",
      "    }",
      "  }",
      "",
      "  return dist;",
      "}"
    ],
    "description": "Dijkstra shortest path"
  },
  "0-1 BFS": {
    "prefix": "01bfs",
    "body": [
      "vector<int> bfs01(",
      "    int n,",
      "    const vector<vector<pair<int, int>>>& g,",
      "    int src",
      ") {",
      "  const int INF = 1e9;",
      "  vector<int> dist(n, INF);",
      "  deque<int> dq;",
      "",
      "  dist[src] = 0;",
      "  dq.push_back(src);",
      "",
      "  while (!dq.empty()) {",
      "    int u = dq.front();",
      "    dq.pop_front();",
      "",
      "    for (auto [v, w] : g[u]) {",
      "      if (dist[v] > dist[u] + w) {",
      "        dist[v] = dist[u] + w;",
      "",
      "        if (w == 0) dq.push_front(v);",
      "        else dq.push_back(v);",
      "      }",
      "    }",
      "  }",
      "",
      "  return dist;",
      "}"
    ],
    "description": "0-1 BFS shortest path"
