      "int merge(vector<int>& v, int l, int mid, int r) {",
      "  int i = l, j = mid + 1, k = 0;",
      "  int inv = 0;",
      "  vector<int> t(r - l + 1);",
      "  while (i <= mid && j <= r) {",
      "    if (v[i] <= v[j]) {",
      "      t[k++] = v[i++];",
      "    }",
      "    else {",
      "      t[k++] = v[j++];",
      "      inv += (mid - i + 1);",
      "      inv %= mod;",
      "    }",
      "  }",
      "",
      "  while (i <= mid) t[k++] = v[i++];",
      "  while (j <= r) t[k++] = v[j++];",
      "",
      "  for (int i = l; i <= r; i++) {",
      "    v[i] = t[i - l];",
      "  }",
      "  return inv;",
      "}",
      "",
      "int mergeSort(vector<int>& v, int l, int r) {",
      "  int inv = 0;",
      "  if (l < r) {",
      "    int mid = (l + r) >> 1;",
      "    inv += mergeSort(v, l, mid);",
      "    inv %= mod;",
      "    inv += mergeSort(v, mid + 1, r);",
      "    inv %= mod;",
      "    inv += merge(v, l, mid, r);",
      "    inv %= mod;",
      "  }",
      "  return inv;",
      "}"
    ],
    "description": "Merge Sort"
