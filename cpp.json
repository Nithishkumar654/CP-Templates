  "Matrix Exponentiation": {
    "prefix": "mat expo",
    "body": [
      "const int K = 4;",
      "struct Matrix {",
      "  long long a[K][K]{};",
      "  Matrix operator*(const Matrix& other) const {",
      "    Matrix res{};",
      "    for (int i = 0; i < K; i++)",
      "      for (int k = 0; k < K; k++)",
      "        for (int j = 0; j < K; j++)",
      "          res.a[i][j] = (res.a[i][j] + a[i][k] * other.a[k][j]) % M;",
      "",
      "    return res;",
      "  }",
      "};",
      "",
      "Matrix power(Matrix base, long long n) {",
      "  Matrix res{};",
      "  for (int i = 0; i < K; i++)",
      "    res.a[i][i] = 1;",
      "",
      "  while (n > 0) {",
      "    if (n & 1)",
      "      res = res * base;",
      "    base = base * base;",
      "    n >>= 1;",
      "  }",
      "  return res;",
      "}"
    ],
    "description": "Matrix Exponentiation"
  },
