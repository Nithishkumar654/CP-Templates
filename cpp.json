      "class SuffixArray {",
      "public:",
      "  vector<int> lcp, p, c, cnt;",
      "  int n;",
      "  string s;",
      "  SuffixArray(string& s) {",
      "    s += \"$\";",
      "    this->s = s;",
      "    n = s.length();",
      "    lcp.resize(n);",
      "    p.resize(n);",
      "    c.resize(n);",
      "    cnt.resize(max(int(256), n));",
      "    build();",
      "  }",
      "  void build() {",
      "    for (int i = 0; i < n; i++)",
      "      cnt[s[i]]++;",
      "    for (int i = 1; i < 256; i++)",
      "      cnt[i] += cnt[i - 1];",
      "    for (int i = n - 1; i >= 0; i--)",
      "      p[--cnt[s[i]]] = i;",
      "    int r = 0;",
      "    c[p[0]] = r;",
      "    for (int i = 1; i < n; i++) {",
      "      if (s[p[i]] != s[p[i - 1]])",
      "        r++;",
      "      c[p[i]] = r;",
      "    }",
      "    for (int k = 1; k < n; k <<= 1) {",
      "      // sort",
      "      // sort(p.begin(), p.end(), [&](auto &a, auto &b){",
      "      //   if(c[a] == c[b]) return c[(a + k) % n] < c[(b + k) % n];",
      "      //   return c[a] < c[b];",
      "      // });",
      "      // count and radix sort",
      "      fill(cnt.begin(), cnt.end(), 0);",
      "      vector<int> pn(n);",
      "      for (int i = 0; i < n; i++)",
      "        pn[i] = (p[i] - k + n) % n;",
      "      for (int i = 0; i < n; i++)",
      "        cnt[c[pn[i]]]++;",
      "      for (int i = 1; i < cnt.size(); i++)",
      "        cnt[i] += cnt[i - 1];",
      "      for (int i = n - 1; i >= 0; i--)",
      "        p[--cnt[c[pn[i]]]] = pn[i];",
      "      // rank",
      "      vector<int> cn(n);",
      "      int r = 0;",
      "      cn[p[0]] = r;",
      "      for (int i = 1; i < n; i++) {",
      "        if (c[p[i - 1]] != c[p[i]] or c[(p[i] + k) % n] != c[(p[i - 1] + k) % n])",
      "          r++;",
      "        cn[p[i]] = r;",
      "      }",
      "      swap(cn, c);",
      "    }",
      "    LCP();",
      "  }",
      "  void LCP() {",
      "    int k = 0;",
      "    for (int i = 0; i < n; i++) {",
      "      int j = p[c[i] - 1];",
      "      while (i + k < n and j + k < n and s[i + k] == s[j + k]) k++;",
      "      lcp[c[i]] = k;",
      "      if (k > 0) k--;",
      "    }",
      "  }",
      "};"
    ],
    "description": "Suffix Array"
  },
  "Rabin Karp": {
    "prefix": "rabinkarp",
    "body": [
      "int power(int a, int b, int mod) {",
      "  if (b == 0) return 1;",
      "  int ans = power(a, b / 2, mod);",
      "  ans = (ans * 1LL * ans) % mod;",
      "  if (b & 1) return (ans * 1LL * a) % mod;",
      "  return ans;",
      "}",
      "",
      "vector<vector<long long>> inv, h;",
      "pair<int, int> substr(int l, int r) {",
      "  const int m = 1e9 + 9;",
      "  const int mod = 1e9 + 7;",
      "  long long c0 = h[r + 1][0];",
      "  c0 = (c0 - h[l][0] + m) % m;",
      "  c0 = (c0 * inv[l][0]) % m;",
      "  long long c1 = h[r + 1][1];",
      "  c1 = (c1 - h[l][1] + mod) % mod;",
      "  c1 = (c1 * inv[l][1]) % mod;",
      "  return make_pair(c0, c1);",
      "}",
      "",
      "void rabin_karp(vector<int>& a) {",
      "  const int p = 911382323;",
      "  const int m = 1e9 + 9;",
      "  const int mod = 1e9 + 7;",
      "  int n = a.size();",
      "",
      "  vector p_pow(n + 1, vector<long long>(2));",
      "  inv = p_pow;",
      "  h = p_pow;",
      "  p_pow[0][0] = 1;",
      "  p_pow[0][1] = 1;",
      "  for (int i = 1; i < (int)p_pow.size(); i++) {",
      "    p_pow[i][0] = (p_pow[i - 1][0] * p) % m;",
      "    p_pow[i][1] = (p_pow[i - 1][1] * p) % mod;",
      "  }",
      "",
      "  inv[n][0] = power(p_pow[n][0], m - 2, m);",
      "  inv[n][1] = power(p_pow[n][1], mod - 2, mod);",
      "  for (int i = n - 1; i >= 0; i--) {",
      "    inv[i][0] = (inv[i + 1][0] * p) % m;",
      "    inv[i][1] = (inv[i + 1][1] * p) % mod;",
      "  }",
      "",
      "  for (int i = 0; i < n; i++) {",
      "    h[i + 1][0] = (h[i][0] + a[i] * p_pow[i][0]) % m;",
      "    h[i + 1][1] = (h[i][1] + a[i] * p_pow[i][1]) % mod;",
      "  }",
      "}"
    ],
    "description": "Rabin Karp"
  }
}
