  "Lazy Segment Tree": {
    "prefix": "lazyseg",
    "body": [
      "struct Node; struct F;",
      "template <class T = Node, class Z = F>",
      "class SegmentTree {",
      "  vector<T> segTree;",
      "  vector<Z> lazy;",
      "  int n;",
      " ",
      "  T combine(T a, T b);",
      "  void U(Z& node, int val);",
      "  void apply(T& node, Z& cur);",
      "  void propagate(Z& cur, Z& child);",
      " ",
      "  void push(int i, int l, int r) {",
      "    if (!lazy[i].have) return;",
      "    apply(segTree[i], lazy[i]);",
      "    if (l != r) {",
      "      propagate(lazy[i], lazy[2 * i + 1]);",
      "      propagate(lazy[i], lazy[2 * i + 2]);",
      "    }",
      "    lazy[i] = Z();",
      "  }",
      " ",
      "  void build(int i, int l, int r) {",
      "    segTree[i] = T(l, r);",
      "    lazy[i] = Z();",
      "    if (l == r) {",
      "      return;",
      "    }",
      "    int mid = (l + r) >> 1;",
      "    build(2 * i + 1, l, mid);",
      "    build(2 * i + 2, mid + 1, r);",
      "    segTree[i] = combine(segTree[2 * i + 1], segTree[2 * i + 2]);",
      "  }",
      " ",
      "  void update(int i, int low, int high, int val, int l, int r) {",
      "    push(i, low, high);",
      "    if (low > r or high < l) return;",
      "    if (low >= l and high <= r) {",
      "      U(lazy[i], val);",
      "      push(i, low, high);",
      "      return;",
      "    }",
      "    int mid = (low + high) >> 1;",
      "    update(2 * i + 1, low, mid, val, l, r);",
      "    update(2 * i + 2, mid + 1, high, val, l, r);",
      "    segTree[i] = combine(segTree[2 * i + 1], segTree[2 * i + 2]);",
      "  }",
      " ",
      "  T query(int i, int low, int high, int l, int r) {",
      "    push(i, low, high);",
      "    if (low > r or high < l) return T();",
      "    if (low >= l and high <= r) return segTree[i];",
      "    int mid = (low + high) >> 1;",
      "    T left = query(2 * i + 1, low, mid, l, r);",
      "    T right = query(2 * i + 2, mid + 1, high, l, r);",
      "    return combine(left, right);",
      "  }",
      " ",
      " ",
      "public:",
      "  SegmentTree(int n) {",
      "    this->n = n;",
      "    segTree.assign(4 * n + 1, T());",
      "    lazy.assign(4 * n + 1, Z());",
      "    build(0, 0, n - 1);",
      "  }",
      "  void update(int l, int r, int val) {",
      "    update(0, 0, n - 1, val, l, r);",
      "  }",
      "  T query(int l, int r) {",
      "    return query(0, 0, n - 1, l, r);",
      "  }",
      "};",
      " ",
      "struct Node {",
      "  int l, r, val;",
      "  Node(int l = -1, int r = -1, int val = 0)",
      "    : val(val), l(l), r(r) {",
      "  }",
      "};",
      " ",
      "// lazy Node",
      "struct F {",
      "  bool have;",
      "  int val;",
      "  F(bool have = false, int val = 0)",
      "    : have(have), val(val) {",
      "  }",
      "};",
      " ",
      "template<class T, class Z>",
      "T SegmentTree<T, Z>::combine(T a, T b) {",
      "  if (a.l == -1) return b;",
      "  if (b.l == -1) return a;",
      "  T res;",
      "  res.l = a.l; res.r = b.r;",
      "  res.val = a.val + b.val;",
      "  return res;",
      "}",
      " ",
      "template<class T, class Z>",
      "void SegmentTree<T, Z>::U(Z& node, int val) {",
      "  node = Z(true, val);",
      "}",
      " ",
      "template<class T, class Z>",
      "void SegmentTree<T, Z>::apply(T& node, Z& cur) {",
      "  int l = node.l, r = node.r;",
      "  if (cur.have) node.val = (r - l + 1) * cur.val;",
      "}",
      " ",
      "template<class T, class Z>",
      "void SegmentTree<T, Z>::propagate(Z& cur, Z& child) {",
      "  if (cur.have) child = cur;",
      "}"
    ],
    "description": "Lazy Segment Tree"
  },
